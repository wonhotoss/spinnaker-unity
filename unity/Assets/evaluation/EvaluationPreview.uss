.evaluation-root {
    flex-grow: 1;
    flex-direction: row;
    background-color: rgb(5, 5, 5);
}

.preview-stage {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
}

.preview-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.empty-label {
    position: absolute;
    left: 24px;
    top: 24px;
    color: rgb(255, 255, 255);
    font-size: 18px;
}

.control-panel {
    width: 380px;
    min-width: 320px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgb(31, 31, 31);
}

.title-label {
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.info-label {
    color: rgb(224, 224, 224);
    margin-bottom: 4px;
    white-space: normal;
}

.button-row {
    flex-direction: row;
    margin-top: 8px;
}

.panel-button {
    flex-grow: 1;
    height: 30px;
    -unity-text-align: middle-center;
}

.left-button {
    margin-right: 8px;
}

.section-label {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 14px;
    margin-bottom: 6px;
}

.limit-row {
    margin-top: 8px;
}

.limit-label {
    color: rgb(224, 224, 224);
    margin-bottom: 2px;
}

.limit-controls {
    flex-direction: row;
}

.limit-slider {
    flex-grow: 1;
    margin-right: 8px;
}

.limit-field {
    width: 78px;
}
